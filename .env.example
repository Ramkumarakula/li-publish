# Copy to $LI_HOME/.env (default ~/.claude/linkedin/.env) and fill in your own app's keys.
# Never commit the real .env.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# LINKEDIN_ACCESS_TOKEN, LINKEDIN_TOKEN_EXPIRES and LINKEDIN_PERSON_URN are
# added here by auth.py after you log in. Do not fill them in by hand.

# Optional: pin a different LinkedIn API version (YYYYMM).
# LINKEDIN_API_VERSION=202608
